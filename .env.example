# Copy to `.env` and fill in. Never commit `.env`.
# Only VITE_-prefixed variables reach the client bundle — never put a secret here.
# Read exclusively through src/config/env.ts (see CLAUDE.md section 7).

# Supabase project URL
VITE_SUPABASE_URL=

# Supabase anon / public key — NOT the service_role key
VITE_SUPABASE_ANON_KEY=

# Express backend base URL (Mina_Back_Dev)
VITE_API_BASE_URL=

# development | staging | production
VITE_APP_ENV=development
